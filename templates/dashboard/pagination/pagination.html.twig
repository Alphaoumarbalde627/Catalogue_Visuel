{% if pageCount > 1 %}

    <nav
        class="mt-12 flex items-center justify-center"
        aria-label="Pagination"
    >

        <div class="flex items-center gap-2">

            {# ===================================================== #}
            {# PAGE PRÉCÉDENTE #}
            {# ===================================================== #}

            {% if previous is defined %}

                <a
                    href="{{ path(route, query|merge({(pageParameterName): previous})) }}"
                    class="group inline-flex h-11 items-center gap-2 rounded-full border border-[#dce9f8] bg-white px-5 text-sm font-medium text-[#1f324d] shadow-sm transition-all duration-200 hover:border-[#2b7bc6] hover:bg-[#eef5ff] hover:shadow-md"
                >

                    <span
                        class="text-lg leading-none transition-transform duration-200 group-hover:-translate-x-0.5"
                    >
                        ←
                    </span>

                    <span>
                        Précédent
                    </span>

                </a>

            {% endif %}


            {# ===================================================== #}
            {# NUMÉROS DES PAGES #}
            {# ===================================================== #}

            <div class="flex items-center gap-2">

                {% for page in pagesInRange %}

                    {% if page == '...' %}

                        <span
                            class="inline-flex h-11 w-10 items-center justify-center text-sm font-medium text-[#8c9eb9]"
                        >
                            …
                        </span>

                    {% elseif page == current %}

                        <span
                            aria-current="page"
                            class="inline-flex h-11 min-w-11 items-center justify-center rounded-full bg-[#2b7bc6] px-4 text-sm font-semibold text-white shadow-md shadow-[#2b7bc6]/20"
                        >
                            {{ page }}
                        </span>

                    {% else %}

                        <a
                            href="{{ path(route, query|merge({(pageParameterName): page})) }}"
                            class="inline-flex h-11 min-w-11 items-center justify-center rounded-full border border-[#dce9f8] bg-white px-4 text-sm font-medium text-[#1f324d] shadow-sm transition-all duration-200 hover:border-[#2b7bc6] hover:bg-[#eef5ff] hover:text-[#2b7bc6] hover:shadow-md"
                        >
                            {{ page }}
                        </a>

                    {% endif %}

                {% endfor %}

            </div>


            {# ===================================================== #}
            {# PAGE SUIVANTE #}
            {# ===================================================== #}

            {% if next is defined %}

                <a
                    href="{{ path(route, query|merge({(pageParameterName): next})) }}"
                    class="group inline-flex h-11 items-center gap-2 rounded-full border border-[#dce9f8] bg-white px-5 text-sm font-medium text-[#1f324d] shadow-sm transition-all duration-200 hover:border-[#2b7bc6] hover:bg-[#eef5ff] hover:shadow-md"
                >

                    <span>
                        Suivant
                    </span>

                    <span
                        class="text-lg leading-none transition-transform duration-200 group-hover:translate-x-0.5"
                    >
                        →
                    </span>

                </a>

            {% endif %}

        </div>

    </nav>

{% endif %}