{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}

<div class="min-h-screen flex items-center justify-center bg-slate-50 px-4 py-10">


    <div class="w-full max-w-5xl bg-white rounded-3xl shadow-xl overflow-hidden grid grid-cols-1 lg:grid-cols-2">


        <!-- Partie gauche : présentation -->

        <div class="hidden lg:flex flex-col justify-center bg-gradient-to-br from-[#2b7bc6] to-[#235ea3] p-12 text-white">


            <div class="mb-8">


                <div class="flex items-center justify-center w-16 h-16 rounded-2xl bg-white/20 backdrop-blur mb-6">
                    ✨
                </div>



                <h2 class="text-4xl font-bold leading-tight">
                    Créez votre espace
                </h2>



                <p class="mt-5 text-blue-100 text-lg leading-relaxed">
                    Rejoignez notre plateforme et profitez d'une expérience
                    simple, moderne et sécurisée.
                </p>


            </div>




            <div class="mt-8 space-y-4">


                <div class="flex items-center gap-4 bg-white/10 rounded-2xl p-4">


                    <div class="w-10 h-10 flex items-center justify-center rounded-xl bg-white/20">
                        🚀
                    </div>


                    <div>

                        <h3 class="font-semibold">
                            Inscription rapide
                        </h3>


                        <p class="text-sm text-blue-100">
                            Créez votre compte en quelques secondes.
                        </p>

                    </div>


                </div>




                <div class="flex items-center gap-4 bg-white/10 rounded-2xl p-4">


                    <div class="w-10 h-10 flex items-center justify-center rounded-xl bg-white/20">
                        🔐
                    </div>


                    <div>

                        <h3 class="font-semibold">
                            Données sécurisées
                        </h3>


                        <p class="text-sm text-blue-100">
                            Vos informations restent protégées.
                        </p>

                    </div>


                </div>




                <div class="rounded-2xl border border-white/10 bg-white/10 p-4 text-sm text-slate-200">


                    <p class="font-medium text-base">
                        Une expérience professionnelle
                    </p>


                    <p class="mt-2 text-slate-200 leading-relaxed">
                        Accédez à un environnement conçu pour simplifier
                        votre gestion et améliorer votre productivité.
                    </p>


                </div>


            </div>


        </div>





        <!-- Partie droite : formulaire -->

        <div class="p-8 sm:p-10 lg:p-12 flex flex-col justify-center">



            <div class="mb-8 text-center">


                <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-50 text-2xl">
                    👤
                </div>



                <h1 class="text-3xl font-bold text-slate-900">
                    Créer un compte
                </h1>



                <p class="mt-2 text-sm text-slate-500">
                    Remplissez les informations ci-dessous pour vous inscrire
                </p>


            </div>





            {{ form_errors(registrationForm) }}




            {{ form_start(registrationForm, {
                attr: {
                    class: 'space-y-5'
                }
            }) }}




                <div>

                    {{ form_label(registrationForm.email, 'Adresse email', {
                        label_attr: {
                            class: 'mb-2 block text-sm font-medium text-slate-700'
                        }
                    }) }}


                    {{ form_widget(registrationForm.email, {
                        attr: {
                            class: 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-[#2b7bc6] focus:bg-white focus:ring-4 focus:ring-blue-100'
                        }
                    }) }}


                    {{ form_errors(registrationForm.email) }}

                </div>





                <div>


                    {{ form_label(registrationForm.plainPassword, 'Mot de passe', {
                        label_attr: {
                            class: 'mb-2 block text-sm font-medium text-slate-700'
                        }
                    }) }}



                    <div class="relative" data-password-toggle>
                        {{ form_widget(registrationForm.plainPassword, {
                            attr: {
                                class: 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 pr-12 text-sm outline-none transition focus:border-[#2b7bc6] focus:bg-white focus:ring-4 focus:ring-blue-100'
                            }
                        }) }}
                        <button type="button" data-password-toggle-button aria-label="Afficher le mot de passe" class="absolute inset-y-0 right-0 flex w-12 items-center justify-center text-slate-400 transition hover:text-[#2b7bc6]">
                            <svg aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5" stroke-width="1.8"/></svg>
                        </button>
                    </div>



                    {{ form_errors(registrationForm.plainPassword) }}


                </div>






                <div class="flex items-center gap-3 text-sm text-slate-600">


                    {{ form_widget(registrationForm.agreeTerms, {
                        attr: {
                            class: 'h-4 w-4 rounded border-slate-300 text-[#2b7bc6]'
                        }
                    }) }}



                    {{ form_label(registrationForm.agreeTerms, 'J’accepte les conditions d’utilisation') }}



                </div>







                <button
                    type="submit"
                    class="w-full rounded-2xl bg-[#2b7bc6] px-4 py-3 font-semibold text-white shadow-lg transition hover:bg-[#235ea3]"
                >
                    Créer mon compte
                </button>




            {{ form_end(registrationForm) }}







            <div class="mt-8 text-center text-sm text-slate-500">


                <p>

                    Souhaitez-vous retourner à la page d’accueil ?

                    <a href="{{ path('app_dashboard') }}"
                       class="font-semibold text-[#2b7bc6] transition hover:text-[#235ea3]">
                        Oui
                    </a>

                </p>


            </div>



        </div>


    </div>


</div>


{% endblock %}