{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}

<div class="min-h-screen flex items-center justify-center bg-slate-50 px-4 py-10">

<div class="w-full max-w-5xl bg-white rounded-3xl shadow-xl overflow-hidden grid grid-cols-1 lg:grid-cols-2">

    <!-- Partie gauche : présentation -->
    <div class="hidden lg:flex flex-col justify-center bg-gradient-to-br from-[#2b7bc6] to-[#235ea3] p-12 text-white">

        <div class="mb-8">

            <div class="flex items-center justify-center w-16 h-16 rounded-2xl bg-white/20 backdrop-blur mb-6">
                🔐
            </div>

            <h2 class="text-4xl font-bold leading-tight">
                Réinitialisez votre mot de passe
            </h2>

            <p class="mt-5 text-blue-100 text-lg leading-relaxed">
                Vous avez oublié votre mot de passe ?
                Pas d’inquiétude. Nous allons vous aider à récupérer
                l’accès à votre espace en quelques étapes.
            </p>

        </div>

        <div class="mt-8 space-y-4">

            <!-- Étape 1 -->
            <div class="flex items-center gap-4 bg-white/10 rounded-2xl p-4">

                <div class="w-10 h-10 flex-shrink-0 flex items-center justify-center rounded-xl bg-white/20 font-semibold">
                    1
                </div>

                <div>
                    <h3 class="font-semibold">
                        Saisissez votre e-mail
                    </h3>

                    <p class="text-sm text-blue-100">
                        Indiquez l’adresse associée à votre compte.
                    </p>
                </div>

            </div>

            <!-- Étape 2 -->
            <div class="flex items-center gap-4 bg-white/10 rounded-2xl p-4">

                <div class="w-10 h-10 flex-shrink-0 flex items-center justify-center rounded-xl bg-white/20 font-semibold">
                    2
                </div>

                <div>
                    <h3 class="font-semibold">
                        Consultez votre boîte mail
                    </h3>

                    <p class="text-sm text-blue-100">
                        Vous recevrez un lien sécurisé.
                    </p>
                </div>

            </div>

            <!-- Étape 3 -->
            <div class="flex items-center gap-4 bg-white/10 rounded-2xl p-4">

                <div class="w-10 h-10 flex-shrink-0 flex items-center justify-center rounded-xl bg-white/20 font-semibold">
                    3
                </div>

                <div>
                    <h3 class="font-semibold">
                        Créez un nouveau mot de passe
                    </h3>

                    <p class="text-sm text-blue-100">
                        Choisissez un nouveau mot de passe sécurisé.
                    </p>
                </div>

            </div>

            <div class="rounded-2xl border border-white/10 bg-white/10 p-4 text-sm text-blue-100">

                <p class="font-medium text-base text-white">
                    🔒 Une procédure sécurisée
                </p>

                <p class="mt-2 leading-relaxed">
                    Le lien de réinitialisation sera personnel,
                    temporaire et utilisable uniquement pour votre compte.
                </p>

            </div>

        </div>

    </div>

    <!-- Partie droite : formulaire -->
    <div class="p-8 sm:p-10 lg:p-12 flex flex-col justify-center">

        <div class="mb-8 text-center">

            <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-50 text-2xl">
                ✉️
            </div>

            <h1 class="text-3xl font-bold text-slate-900">
                Mot de passe oublié ?
            </h1>

            <p class="mt-3 text-sm text-slate-500 leading-relaxed">
                Entrez l’adresse e-mail associée à votre compte.
                Nous vous enverrons un lien pour réinitialiser votre mot de passe.
            </p>

        </div>

        {{ form_start(form, {
            'attr': {
                'class': 'space-y-5'
            }
        }) }}
            
            <div>

                {{ form_label(form.email, null, {
                    'label_attr': {
                        'class': 'mb-2 block text-sm font-medium text-slate-700'
                    }
                }) }}

                {{ form_widget(form.email, {
                    'attr': {
                        'class': 'w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-[#2b7bc6] focus:bg-white focus:ring-2 focus:ring-blue-100',
                        'placeholder': 'exemple@email.com'
                    }
                }) }}

                {{ form_errors(form.email) }}

            </div>

            <div class="pt-2">

                {{ form_widget(form.submit, {
                    'attr': {
                        'class': 'w-full rounded-xl bg-[#2b7bc6] px-5 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-[#235ea3] hover:shadow-md focus:outline-none focus:ring-2 focus:ring-[#2b7bc6] focus:ring-offset-2'
                    }
                }) }}

            </div>

        {{ form_end(form) }}

        <div class="mt-8 flex flex-col items-center justify-center gap-4 text-sm text-slate-500">

            <a href="{{ path('app_login') }}"
               class="rounded-full border border-[#dce9f8] bg-white px-5 py-3 text-xs uppercase tracking-[0.24em] text-[#1f324d] transition hover:border-[#2b7bc6] hover:text-[#2b7bc6]">
                ← Retour à la connexion
            </a>

        </div>

    </div>

</div>

</div>

{% endblock %}
