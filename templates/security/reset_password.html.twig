{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe{% endblock %}

{% block body %}

<div class="min-h-screen flex items-center justify-center bg-slate-50 px-4 py-10">

    <div class="w-full max-w-5xl overflow-hidden rounded-3xl bg-white shadow-2xl grid grid-cols-1 lg:grid-cols-2">

        <!-- Partie gauche -->
        <div class="hidden lg:flex flex-col justify-center bg-gradient-to-br from-[#2b7bc6] via-[#286fae] to-[#235ea3] p-12 text-white">

            <div class="mb-8">

                <div class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/20 text-3xl shadow-lg backdrop-blur">
                    🔐
                </div>

                <h2 class="text-4xl font-bold leading-tight">
                    Sécurisez votre compte
                </h2>

                <p class="mt-5 text-lg leading-relaxed text-blue-100">
                    Choisissez un nouveau mot de passe afin de protéger
                    votre compte et retrouver votre accès en toute sécurité.
                </p>

            </div>

            <div class="mt-6 space-y-4">

                <!-- Sécurité -->
                <div class="flex items-center gap-4 rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur">

                    <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-white/20 text-xl">
                        🔑
                    </div>

                    <div>
                        <h3 class="font-semibold">
                            Nouveau mot de passe
                        </h3>

                        <p class="mt-1 text-sm text-blue-100">
                            Choisissez un mot de passe difficile à deviner.
                        </p>
                    </div>

                </div>

                <!-- Protection -->
                <div class="flex items-center gap-4 rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur">

                    <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-white/20 text-xl">
                        🛡️
                    </div>

                    <div>
                        <h3 class="font-semibold">
                            Protection renforcée
                        </h3>

                        <p class="mt-1 text-sm text-blue-100">
                            Votre mot de passe sera sécurisé avant son enregistrement.
                        </p>
                    </div>

                </div>

                <!-- Token -->
                <div class="flex items-center gap-4 rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur">

                    <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-white/20 text-xl">
                        ⏱️
                    </div>

                    <div>
                        <h3 class="font-semibold">
                            Lien temporaire
                        </h3>

                        <p class="mt-1 text-sm text-blue-100">
                            Le lien de réinitialisation est valable pendant une durée limitée.
                        </p>
                    </div>

                </div>

            </div>

        </div>

        <!-- Partie droite -->
        <div class="flex flex-col justify-center p-8 sm:p-10 lg:p-12">

            <div class="mb-8 text-center">

                <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-50 text-2xl shadow-sm">
                    🔑
                </div>

                <h1 class="text-3xl font-bold text-slate-900">
                    Nouveau mot de passe
                </h1>

                <p class="mt-3 text-sm leading-relaxed text-slate-500">
                    Saisissez votre nouveau mot de passe puis confirmez-le
                    afin de terminer la réinitialisation.
                </p>

            </div>

            <!-- Formulaire -->
            {{ form_start(form, {
                'attr': {
                    'class': 'space-y-6'
                }
            }) }}

                <div>

                    {{ form_label(form.password, null, {
                        'label_attr': {
                            'class': 'mb-2 block text-sm font-semibold text-slate-700'
                        }
                    }) }}

                    <div class="relative" data-password-toggle>
                        {{ form_widget(form.password, {
                            'attr': {
                                'class': 'w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3.5 pr-12 text-sm text-slate-900 outline-none transition focus:border-[#2b7bc6] focus:bg-white focus:ring-2 focus:ring-blue-100',
                                'placeholder': 'Entrez votre nouveau mot de passe'
                            }
                        }) }}
                        <button type="button" data-password-toggle-button aria-label="Afficher le mot de passe" class="absolute inset-y-0 right-0 flex w-12 items-center justify-center text-slate-400 transition hover:text-[#2b7bc6]">
                            <svg aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5" stroke-width="1.8"/></svg>
                        </button>
                    </div>

                    {{ form_errors(form.password) }}

                </div>

                <div>

                    {{ form_label(form.confirmPassword, null, {
                        'label_attr': {
                            'class': 'mb-2 block text-sm font-semibold text-slate-700'
                        }
                    }) }}

                    <div class="relative" data-password-toggle>
                        {{ form_widget(form.confirmPassword, {
                            'attr': {
                                'class': 'w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3.5 pr-12 text-sm text-slate-900 outline-none transition focus:border-[#2b7bc6] focus:bg-white focus:ring-2 focus:ring-blue-100',
                                'placeholder': 'Confirmez votre nouveau mot de passe'
                            }
                        }) }}
                        <button type="button" data-password-toggle-button aria-label="Afficher le mot de passe" class="absolute inset-y-0 right-0 flex w-12 items-center justify-center text-slate-400 transition hover:text-[#2b7bc6]">
                            <svg aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5" stroke-width="1.8"/></svg>
                        </button>
                    </div>

                    {{ form_errors(form.confirmPassword) }}

                </div>

                <!-- Information sécurité -->
                <div class="rounded-xl border border-blue-100 bg-blue-50 px-4 py-3">

                    <div class="flex items-start gap-3">

                        <span class="text-lg">
                            💡
                        </span>

                        <p class="text-xs leading-relaxed text-blue-700">
                            Votre mot de passe doit contenir au minimum
                            <strong>8 caractères</strong>.
                            Évitez d'utiliser des informations faciles à deviner.
                        </p>

                    </div>

                </div>

                <div class="pt-1">

                    {{ form_widget(form.submit, {
                        'attr': {
                            'class': 'w-full rounded-xl bg-[#2b7bc6] px-5 py-3.5 text-sm font-semibold text-white shadow-md transition hover:bg-[#235ea3] hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-[#2b7bc6] focus:ring-offset-2'
                        }
                    }) }}

                </div>

            {{ form_end(form) }}

            <div class="mt-8 flex justify-center">

                <a
                    href="{{ path('app_login') }}"
                    class="rounded-full border border-[#dce9f8] bg-white px-5 py-3 text-xs font-medium uppercase tracking-[0.2em] text-[#1f324d] transition hover:border-[#2b7bc6] hover:text-[#2b7bc6]"
                >
                    ← Retour à la connexion
                </a>

            </div>

        </div>

    </div>

</div>

{% endblock %}

