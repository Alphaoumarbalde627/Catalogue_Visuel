{% extends 'base.html.twig' %}

{% block title %}Ajouter un produit{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f7f0e6] text-[#1f324d]">
    <div class="max-w-3xl mx-auto px-8 py-10">
        <div class="mb-8">
            <h1 class="text-3xl font-semibold">Ajouter un produit</h1>
            <p class="mt-2 text-sm text-[#5b718e]">Ajoutez un produit et importez son image.</p>
        </div>

        {{ form_start(productForm, {'attr': {'class': 'space-y-6', 'data-turbo': 'false'}, 'multipart': true}) }}
            {{ form_errors(productForm) }}
            <div class="grid gap-6">
                <div>
                    {{ form_label(productForm.reference) }}
                    {{ form_widget(productForm.reference, {'attr': {'class': 'w-full rounded-md border border-slate-200 bg-white px-4 py-3'}}) }}
                </div>
                <div>
                    {{ form_label(productForm.designation) }}
                    {{ form_widget(productForm.designation, {'attr': {'class': 'w-full rounded-md border border-slate-200 bg-white px-4 py-3'}}) }}
                </div>
                <div>
                    {{ form_label(productForm.description) }}
                    {{ form_widget(productForm.description, {'attr': {'class': 'w-full rounded-md border border-slate-200 bg-white px-4 py-3'}}) }}
                </div>
                <div>
                    {{ form_label(productForm.imageFiles) }}
                    {{ form_widget(productForm.imageFiles, {'attr': {'class': 'w-full rounded-md border border-slate-200 bg-white px-4 py-3'}}) }}
                    {{ form_errors(productForm.imageFiles) }}
                </div>
            </div>

            <div class="flex gap-4">
                <button class="rounded-full bg-[#2b7bc6] px-6 py-3 text-sm text-white hover:bg-[#235ea3]" type="submit">Enregistrer</button>
                <a href="{{ path('app_dashboard') }}" class="rounded-full border border-[#dce9f8] px-6 py-3 text-sm text-[#1f324d]">Annuler</a>
            </div>
        {{ form_end(productForm) }}
    </div>
</div>
{% endblock %}
