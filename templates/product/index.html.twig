{% extends 'base.html.twig' %}

{% block title %}Catalogue produits{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f7f0e6] text-[#1f324d]">
    <div class="max-w-7xl mx-auto px-8 py-10">
        <div class="flex items-center justify-between mb-8">
            <div>
                <h1 class="text-4xl font-serif">Catalogue produits</h1>
                <p class="mt-2 text-sm text-[#5b718e]">Affichage dynamique des produits avec gestion des images.</p>
            </div>
            <a href="{{ path('app_product_new') }}" class="rounded-full bg-[#2b7bc6] px-5 py-3 text-sm text-white hover:bg-[#235ea3]">Ajouter un produit</a>
        </div>

        <div class="space-y-6">
            {% for product in products %}
                <div class="flex items-center justify-between bg-white p-6 border border-[#f0e6db] rounded-md">
                    <div class="flex items-center gap-6">
                        {% if product.images|length > 0 %}
                            <img src="/image/{{ product.images|first }}" alt="{{ product.designation }}" class="h-20 w-28 object-cover rounded-sm" />
                        {% else %}
                            <div class="h-20 w-28 rounded-sm bg-slate-100"></div>
                        {% endif %}
                        <div>
                            <div class="text-xl font-medium">{{ product.designation }}</div>
                            <div class="mt-1 text-sm text-[#c6a96f] uppercase tracking-[0.18em]">{{ product.reference }} · {{ product.images|length }} PHOTOS</div>
                            <p class="mt-2 text-sm text-[#5b718e]">{{ product.description }}</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-4">
                        <a href="{{ path('app_product_edit', {id: product.id}) }}" class="rounded border border-[#efe6db] px-5 py-3 text-sm text-[#6b6b6b]">Modifier</a>
                        <form method="post" action="{{ path('app_product_delete', {id: product.id}) }}" onsubmit="return confirm('Confirmer la suppression du produit ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-product-' ~ product.id) }}">
                            <button class="rounded border border-[#efe6db] px-5 py-3 text-sm text-[#6b6b6b]" type="submit">Supprimer</button>
                        </form>
                    </div>
                </div>
            {% else %}
                <div class="p-6 bg-white rounded-md border border-[#f0e6db]">Aucun produit trouvé.</div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
