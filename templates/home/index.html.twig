{% extends 'base.html.twig' %}

{% block title %}Maison Élite – Catalogue{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f7f5f0] text-[#1f324d] antialiased" style="font-family:'Inter',sans-serif;">
    <div class="mx-auto max-w-[1180px] px-6 py-10 sm:px-8 lg:px-10 lg:py-14">
        <header class="-mx-6 flex flex-col gap-6 rounded-[5rem] border border-[#dce9f8] bg-[#eef5ff] px-6 py-6 shadow-[90_60px_90px_rgba(31,50,78,0.12)] sm:-mx-8 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
            <div class="flex items-center gap-4">
                <img src="{{ asset('image/Logooo.png') }}" alt="Logo Maison Élite" class="h-16 w-16 rounded-3xl bg-white p-2 shadow-sm" />
                <div>
                    <p class="text-sm font-semibold uppercase tracking-[0.28em] text-[#1f324d]">Maison <span class="text-[#2b7bc6]">Élite</span></p>
                    <p class="text-xs uppercase tracking-[0.35em] text-[#5b718e]">Galerie de meubles</p>
                </div>
            </div>

            <div class="flex flex-wrap items-center justify-end gap-3">
                <a href="{{ path('app_login') }}" class="rounded-full border border-[#dce9f8] bg-white px-5 py-3 text-xs uppercase tracking-[0.24em] text-[#1f324d] transition hover:border-[#2b7bc6]">Connexion</a>
                <a href="{{ path('app_register') }}" class="rounded-full bg-[#2b7bc6] px-5 py-3 text-xs uppercase tracking-[0.24em] text-white transition hover:bg-[#235ea3]">Inscription</a>
            </div>
        </header>

        <section class="mt-16 space-y-10">
            <div class="rounded-[2rem] bg-white p-10 shadow-[0_30px_90px_rgba(31,50,78,0.08)]">
                <div class="text-center lg:text-left">
                    <p class="text-xs uppercase tracking-[0.35em] text-[#5b718e]">Catalogue visuel</p>
                    <h1 class="mt-4 text-4xl font-semibold tracking-[-0.04em] text-[#1f324d] leading-tight sm:text-5xl">Recherchez votre produit</h1>
                    <p class="mt-4 max-w-2xl text-base leading-8 text-[#4a5f84]">Une interface claire et moderne, conçue pour mettre en valeur votre catalogue et guider vos visiteurs vers les meilleures pièces.</p>
                </div>

                <div class="mt-10 grid gap-6 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
                    <div class="rounded-[1.75rem] border border-[#d9e9fb] bg-[#f7fbff] p-5 shadow-sm">
                        <div class="flex items-center gap-4">
                            <span class="text-[#2b7bc6] text-2xl">🔍</span>
                            <input type="text" placeholder="Ex : Salon Royal Luxe, Table Impériale..." class="w-full border-none bg-transparent text-lg font-semibold text-[#1f324d] placeholder:text-[#8c9eb9] focus:outline-none" />
                        </div>
                    </div>
                    <button class="inline-flex h-full min-h-[64px] items-center justify-center rounded-[1.75rem] bg-[#2b7bc6] px-8 py-4 text-sm uppercase tracking-[0.28em] text-white transition hover:bg-[#235ea3]">Rechercher</button>
                </div>

                <div class="mt-10 grid gap-4 sm:grid-cols-4">
                    {% for category in ['Salon', 'Chambre', 'Salle à manger', 'Bureau'] %}
                        <button class="rounded-[1.75rem] border border-[#dbe4f7] bg-white py-5 text-sm uppercase tracking-[0.24em] text-[#4a5f84] transition hover:bg-[#eef5ff]">{{ category }}</button>
                    {% endfor %}
                </div>
            </div>

            <div class="text-center">
                <p class="text-xs uppercase tracking-[0.35em] text-[#5b718e]">Sélection du moment</p>
            </div>

            <div class="grid gap-6 lg:grid-cols-3">
                {% set products = [
                    { 'title': 'Salon Royal Luxe', 'category': 'Salon', 'image': 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1200&q=80' },
                    { 'title': 'Table Impériale', 'category': 'Salle à manger', 'image': 'https://images.unsplash.com/photo-1494526585095-c41746248156?auto=format&fit=crop&w=1200&q=80' },
                    { 'title': 'Chambre Palazzo', 'category': 'Chambre', 'image': 'https://images.unsplash.com/photo-1524758631624-e2822e304c36?auto=format&fit=crop&w=1200&q=80' }
                ] %}

                {% for product in products %}
                    <article class="overflow-hidden rounded-[2rem] bg-white shadow-[0_20px_50px_rgba(31,50,78,0.08)]">
                        <div class="h-72 bg-cover bg-center" style="background-image:url('{{ product.image }}');"></div>
                        <div class="border-t border-[#e8eef8] px-6 py-6">
                            <h3 class="text-xl font-semibold text-[#1f324d]">{{ product.title }}</h3>
                            <p class="mt-2 text-sm uppercase tracking-[0.24em] text-[#2b7bc6]">{{ product.category }}</p>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>
    </div>
</div>

{% endblock %}
