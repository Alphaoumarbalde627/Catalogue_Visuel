{% extends 'base.html.twig' %}

{% block title %}Maison Élite – Catalogue{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f7f5f0] text-[#1f324d] antialiased" style="font-family:'Inter',sans-serif;">
    <div class="mx-auto max-w-[1180px] px-6 py-10 sm:px-8 lg:px-10 lg:py-14">
        <header class="-mx-6 flex flex-col gap-6 rounded-[5rem] border border-[#dce9f8] bg-[#eef5ff] px-6 py-6 shadow-[90_60px_90px_rgba(31,50,78,0.12)] sm:-mx-8 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
            <div class="flex items-center gap-4">
                <img src="{{ asset('image/Logooo.png') }}" alt="Logo Maison Élite" class="h-16 w-16 rounded-3xl bg-white p-2 shadow-sm" />
                <div>
                    <p class="text-sm font-semibold uppercase tracking-[0.28em] text-[#1f324d]">M.P.D <span class="text-[#2b7bc6]">ET FRERES</span></p>
                    <p class="text-xs uppercase tracking-[0.35em] text-[#5b718e]">Galerie de meubles</p>
                </div>
            </div>

            <div class="flex flex-wrap items-center justify-end gap-3">
                <a href="{{ path('app_login') }}" class="rounded-full border border-[#dce9f8] bg-white px-5 py-3 text-xs uppercase tracking-[0.24em] text-[#1f324d] transition hover:border-[#2b7bc6]">Connexion</a>
            </div>
        </header>

        <section class="mt-16 space-y-10">
            <div class="rounded-[2rem] bg-white p-10 shadow-[0_30px_90px_rgba(31,50,78,0.08)]">
                <div class="text-center lg:text-left">
                    <p class="text-xs uppercase tracking-[0.35em] text-[#5b718e]">Catalogue visuel</p>
                    <h1 class="mt-4 text-4xl font-semibold tracking-[-0.04em] text-[#1f324d] leading-tight sm:text-5xl">Recherchez votre produit</h1>
                    <p class="mt-4 max-w-2xl text-base leading-8 text-[#4a5f84]">Une interface claire et moderne, conçue pour mettre en valeur votre catalogue et guider vos visiteurs vers les meilleures pièces.</p>
                </div>

                <form method="get" action="{{ path('app_home') }}" class="mt-10 grid gap-6 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
                    <div class="rounded-[1.75rem] border border-[#d9e9fb] bg-[#f7fbff] p-5 shadow-sm">
                        <div class="flex items-center gap-4">
                            <span class="text-[#2b7bc6] text-2xl">🔍</span>
                            <input type="search" name="search" value="{{ search|default('') }}" placeholder="Ex : Salon Royal Luxe, Table Impériale..." class="w-full border-none bg-transparent text-lg font-semibold text-[#1f324d] placeholder:text-[#8c9eb9] focus:outline-none" />
                        </div>
                    </div>
                    <button type="submit" class="inline-flex h-full min-h-[64px] items-center justify-center rounded-[1.75rem] bg-[#2b7bc6] px-8 py-4 text-sm uppercase tracking-[0.28em] text-white transition hover:bg-[#235ea3]">Rechercher</button>
                </form>

                <div class="mt-10 grid gap-4 sm:grid-cols-4">
                    {% for category in ['Salon', 'Chambre', 'Salle à manger', 'Bureau'] %}
                        <button class="rounded-[1.75rem] border border-[#dbe4f7] bg-white py-5 text-sm uppercase tracking-[0.24em] text-[#4a5f84] transition hover:bg-[#eef5ff]">{{ category }}</button>
                    {% endfor %}
                </div>
            </div>

            <div class="text-center">
                <p class="text-xs uppercase tracking-[0.35em] text-[#5b718e]">Sélection du moment</p>
            </div>

       <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

    {% for product in products %}

        <article class="group overflow-hidden rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300">

            {# Image du produit #}
            <div class="relative h-64 w-full overflow-hidden bg-slate-100">

                {% if product.images|length > 0 %}

                    <a href="{{ path('app_gallery', {id: product.id, from_page: app.request.query.get('page', 1)}) }}" aria-label="Ouvrir la galerie de {{ product.designation }}">
                        <img
                            src="/image/{{ product.images|first }}"
                            alt="{{ product.designation }}"
                            data-images="{{ product.images|json_encode|e('html_attr') }}"
                            data-title="{{ product.designation|e('html_attr') }}"
                            data-reference="{{ product.reference|e('html_attr') }}"
                            data-description="{{ product.description|default('')|e('html_attr') }}"
                            class="h-full w-full cursor-pointer object-cover transition-transform duration-500 group-hover:scale-105"
                        />
                    </a>

                {% else %}

                    <div class="flex h-full w-full flex-col items-center justify-center text-slate-400">

                        <svg
                            class="mb-3 h-12 w-12"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M4 16l4.586-4.586a2 2 0 015.828 0L20 17m-6-6l1.586-1.586a2 2 0 012.828 0L20 12M14 10h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                            />
                        </svg>

                        <span class="text-sm">
                            Aucune image
                        </span>

                    </div>

                {% endif %}

            </div>

            {# Informations du produit #}
            <div class="px-6 py-5">

                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#2b7bc6]">
                    {{ product.reference }}
                </p>

                <h3 class="mt-2 text-xl font-semibold text-[#1f324d]">
                    {{ product.designation }}
                </h3>

                {% if product.description %}
                    <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-500">
                        {{ product.description }}
                    </p>
                {% endif %}

            </div>

        </article>

    {% endfor %}
    {{ knp_pagination_render(products) }}
</div>
</section>
   {# MODAL GALERIE #}
        <div
            id="gallery-modal"
            class="fixed hidden h-screen w-screen bg-[#171717] text-white"
            style="top:0; right:0; bottom:0; left:0; z-index:9999999;"
            role="dialog"
            aria-modal="true"
            aria-labelledby="gallery-title"
            onclick="closeGallery(event)"
        >
            <header
                class="absolute left-0 right-0 top-0 z-20 flex h-32 items-center justify-between bg-[#171717] px-8 sm:px-16"
                onclick="event.stopPropagation()"
            >
                <button
                    type="button"
                    onclick="closeGallery(event)"
                    class="border border-[#8f7531] px-6 py-4 text-sm uppercase tracking-[0.22em] text-[#c8a94e] transition hover:bg-[#282828]"
                >
                    ← Retour
                </button>

                <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-center">
                    <p class="font-serif text-xl tracking-[0.25em] text-[#c8a94e]">ÉLITE</p>
                    <p class="mt-1 text-[10px] uppercase tracking-[0.45em] text-[#9e9e9e]">Galerie de meubles</p>
                </div>

                <button
                    type="button"
                    onclick="toggleFullscreen(event)"
                    class="border border-[#8f7531] px-6 py-4 text-sm uppercase tracking-[0.22em] text-[#c8a94e] transition hover:bg-[#282828]"
                >
                    ⛶ Plein écran
                </button>
            </header>

            <div
                class="grid h-full w-full grid-cols-1 pt-32 lg:grid-cols-[minmax(0,1fr)_31%] lg:pt-32"
                onclick="event.stopPropagation()"
            >
                <div class="relative flex min-h-0 items-center justify-center bg-[#dededb] p-6 sm:p-12">
                    <button
                        type="button"
                        aria-label="Image précédente"
                        onclick="previousGalleryImage(event)"
                        class="absolute left-6 top-1/2 z-10 flex h-20 w-20 -translate-y-1/2 items-center justify-center bg-black/60 text-4xl text-[#c8a94e] transition hover:bg-black/80"
                    >
                        ‹
                    </button>

                    <img
                        id="gallery-image"
                        src=""
                        alt=""
                        class="max-h-full max-w-full object-contain"
                        onclick="event.stopPropagation()"
                    >

                    <button
                        type="button"
                        aria-label="Image suivante"
                        onclick="nextGalleryImage(event)"
                        class="absolute right-6 top-1/2 z-10 flex h-20 w-20 -translate-y-1/2 items-center justify-center bg-black/60 text-4xl text-[#c8a94e] transition hover:bg-black/80"
                    >
                        ›
                    </button>
                </div>

                <aside class="flex min-h-0 flex-col justify-between overflow-y-auto bg-[#f5f1e8] px-8 py-12 text-[#171717] sm:px-14">
                    <div>
                        <p class="text-xs uppercase tracking-[0.35em] text-[#c8a94e]">Galerie</p>
                        <h2 id="gallery-title" class="mt-6 font-serif text-4xl leading-tight sm:text-5xl"></h2>
                        <div class="my-8 flex items-center gap-3 text-[#c8a94e]">
                            <span class="h-px flex-1 bg-[#d9c895]"></span>
                            <span>◆</span>
                            <span class="h-px flex-1 bg-[#d9c895]"></span>
                        </div>
                        <p id="gallery-description" class="text-base leading-8 text-[#6d6b66]"></p>
                        <p id="gallery-reference" class="mt-6 text-xs uppercase tracking-[0.25em] text-[#99958c]"></p>
                    </div>

                    <div class="mt-10">
                        <p id="gallery-counter" class="mb-4 text-xs uppercase tracking-[0.3em] text-[#aaa69e]"></p>
                        <div id="gallery-thumbnails" class="grid grid-cols-3 gap-3"></div>
                    </div>
                </aside>
            </div>
        </div>

        <script>
        let galleryImages = [];
        let galleryIndex = 0;

        function openGallery(event, image) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            const modal = document.getElementById('gallery-modal');
            if (!modal || !image) {
                return false;
            }

            try {
                galleryImages = JSON.parse(image.dataset.images || '[]');
            } catch (error) {
                galleryImages = [];
            }

            if (!Array.isArray(galleryImages) || galleryImages.length === 0) {
                return false;
            }

            galleryIndex = 0;
            document.getElementById('gallery-title').textContent = image.dataset.title || '';
            document.getElementById('gallery-reference').textContent = image.dataset.reference || '';
            document.getElementById('gallery-description').textContent = image.dataset.description || '';
            renderGallery();

            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';

            return false;
        }

        function renderGallery() {
            const galleryImage = document.getElementById('gallery-image');
            const thumbnails = document.getElementById('gallery-thumbnails');
            const counter = document.getElementById('gallery-counter');

            if (!galleryImage || !thumbnails || !counter || !galleryImages.length) {
                return;
            }

            galleryImage.src = '/image/' + galleryImages[galleryIndex];
            counter.textContent = 'Galerie — ' + galleryImages.length + ' photos';
            thumbnails.innerHTML = '';

            galleryImages.forEach((image, index) => {
                const thumbnail = document.createElement('button');
                thumbnail.type = 'button';
                thumbnail.className = 'h-20 overflow-hidden border-2 transition ' + (index === galleryIndex ? 'border-[#c8a94e]' : 'border-transparent');
                thumbnail.setAttribute('aria-label', 'Afficher la photo ' + (index + 1));
                thumbnail.onclick = function(event) {
                    event.preventDefault();
                    event.stopPropagation();
                    galleryIndex = index;
                    renderGallery();
                };

                const thumbnailImage = document.createElement('img');
                thumbnailImage.src = '/image/' + image;
                thumbnailImage.alt = 'Photo ' + (index + 1);
                thumbnailImage.className = 'h-full w-full object-cover';
                thumbnail.appendChild(thumbnailImage);
                thumbnails.appendChild(thumbnail);
            });
        }

        function previousGalleryImage(event) {
            event.preventDefault();
            event.stopPropagation();
            if (galleryImages.length) {
                galleryIndex = (galleryIndex - 1 + galleryImages.length) % galleryImages.length;
                renderGallery();
            }
        }

        function nextGalleryImage(event) {
            event.preventDefault();
            event.stopPropagation();
            if (galleryImages.length) {
                galleryIndex = (galleryIndex + 1) % galleryImages.length;
                renderGallery();
            }
        }

        function closeGallery(event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            const modal = document.getElementById('gallery-modal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }

            document.body.style.overflow = '';

            if (document.fullscreenElement && document.exitFullscreen) {
                document.exitFullscreen().catch(() => {});
            }

            return false;
        }

        function toggleFullscreen(event) {
            event.preventDefault();
            event.stopPropagation();

            const modal = document.getElementById('gallery-modal');
            if (!modal) {
                return false;
            }

            if (document.fullscreenElement) {
                if (document.exitFullscreen) {
                    document.exitFullscreen().catch(() => {});
                }
            } else if (modal.requestFullscreen) {
                modal.requestFullscreen().catch(() => {});
            }

            return false;
        }
        </script>
    </div>
</div>
{% endblock %}
